# ==============================================================================
# CRYPTO_ALPHA_SNIPER - Configuration Template
# ==============================================================================
# Copy this file to .env and configure your variables before running the application.

# ------------------------------------------------------------------------------
# Telegram Alerts Configuration (Optional - leave blank to disable alerts)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite Async WAL Mode Database URI (Default)
DATABASE_URL=sqlite+aiosqlite:///data/crypto_alpha_sniper.db

# ------------------------------------------------------------------------------
# External API Endpoints
# ------------------------------------------------------------------------------
DEXSCREENER_API_BASE=https://api.dexscreener.com
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1

# ------------------------------------------------------------------------------
# Engine & Scanner Parameters
# ------------------------------------------------------------------------------
# Polling interval in seconds between scan batches
SCAN_INTERVAL_SECONDS=60

# Max age of token in minutes to be evaluated (Default: 60)
MAX_AGE_MINUTES=60

# Minimum hourly volume ($ USD) to pass filter (Default: 1000)
MIN_VOLUME_USD=1000.0

# Minimum market cap ($ USD) to pass filter (Default: 1000)
MIN_MARKET_CAP_USD=1000.0

# Supported blockchain networks (comma-separated: solana,bsc,ton,base)
SUPPORTED_CHAINS=solana,bsc,ton

# Concurrency batch size for parallel pair and security analysis
CONCURRENCY_LIMIT=10

# ------------------------------------------------------------------------------
# Scoring & Thresholds (0 - 100 Scale)
# ------------------------------------------------------------------------------
WATCHLIST_SCORE=40
EARLY_SIGNAL_SCORE=55
ALPHA_SIGNAL_SCORE=70

# Max allowed risk score before token is rejected (0 = Safe, 100 = Critical Danger)
MAX_ALLOWED_RISK_SCORE=65

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/crypto_alpha_sniper.log
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
